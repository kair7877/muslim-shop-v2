{
  "entities": {
    "products": {
      "title": "Product",
      "description": "Products available in the Muslim Shop",
      "type": "object",
      "properties": {
        "titleRu": { "type": "string" },
        "titleKz": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "categoryId": { "type": "string" },
        "descriptionRu": { "type": "string" },
        "descriptionKz": { "type": "string" },
        "specsRu": { "type": "string" },
        "specsKz": { "type": "string" },
        "inStock": { "type": "boolean" },
        "sku": { "type": "string" },
        "isHit": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "isSale": { "type": "boolean" },
        "images": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["titleRu", "price", "categoryId", "inStock"]
    },
    "categories": {
      "title": "Category",
      "description": "Categories for organizing products",
      "type": "object",
      "properties": {
        "nameRu": { "type": "string" },
        "nameKz": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["nameRu", "nameKz", "order"]
    },
    "orders": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "comment": { "type": "string" },
        "deliveryMethod": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "clientName", "phone", "items", "totalAmount", "status"]
    },
    "settings": {
      "title": "StoreSettings",
      "description": "General store contact and address settings",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "taglineRu": { "type": "string" },
        "taglineKz": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "instagram": { "type": "string" }
      }
    }
  }
}
